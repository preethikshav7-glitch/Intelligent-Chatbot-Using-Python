# Chatbot
# ---------------------------------------------------------------------------
class Chatbot:
    def __init__(self):
        self.user_name = None

    def respond(self, message: str) -> str:
        text = message.strip()
        if not text:
            return "Say something and I'll respond!"
        lower = text.lower()

        # 1. Remember the user's name
        name_match = re.search(r"(?:my name is|i am|i'm|call me)\s+([a-zA-Z]+)", lower)
        if name_match:
            self.user_name = name_match.group(1).capitalize()
            return f"Nice to meet you, {self.user_name}!"
        if re.search(r"what(?:'s| is) my name|who am i", lower):
            return f"Your name is {self.user_name}." if self.user_name else "I don't know your name yet. Tell me!"

        # 2. Time and date
        if re.search(r"\btime\b", lower):
            return "The current time is " + datetime.now().strftime("%I:%M %p")
        if re.search(r"\b(date|today|day)\b", lower):
            return "Today is " + datetime.now().strftime("%A, %d %B %Y")

        # 3. Math
        math_answer = try_math(text)
        if math_answer:
            return math_answer

        # 4. Intent matching
        tag, _score = classify(text)
        if tag:
            intent = next(i for i in INTENTS if i["tag"] == tag)
            reply = random.choice(intent["responses"])
            if tag == "greeting" and self.user_name:
                reply = reply.replace("Hello!", f"Hello, {self.user_name}!").replace("Hi there!", f"Hi {self.user_name}!")
            return reply

        return random.choice(FALLBACKS)

    @staticmethod
    def is_exit(message: str) -> bool:
        tag, _ = classify(message)
        return tag == "goodbye"


def main():
    bot = Chatbot()
    print("PyBot: Hi! I'm PyBot. Type 'help' to see what I can do, or 'bye' to quit.")
    while True:
        try:
            message = input("You: ")
        except (EOFError, KeyboardInterrupt):
            print("\nPyBot: Goodbye!")
            break
        print("PyBot:", bot.respond(message))
        if bot.is_exit(message):
            break


if __name__ == "__main__":
    main()
