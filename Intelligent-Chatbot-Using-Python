"""
Intelligent Chatbot using Python
--------------------------------
A rule-based NLP chatbot that uses only the Python standard library.

How it works:
1. Preprocessing: lowercase, tokenize, remove stop words, light stemming
2. Typo correction: fuzzy-matches unknown words against known vocabulary
3. Intent matching: scores the message against example patterns (Dice similarity)
4. Special skills: remembers your name, tells time/date, does safe math
"""

import ast
import difflib
import operator
import random
import re
