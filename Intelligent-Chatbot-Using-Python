FALLBACKS = [
    "Sorry, I didn't quite understand that. Could you rephrase?",
    "I'm still learning. Try asking something else, or type 'help'.",
]

# ---------------------------------------------------------------------------
# Text preprocessing
# ---------------------------------------------------------------------------
STOP_WORDS = {"a", "an", "the", "is", "am", "to", "of", "please", "me", "can", "it", "s"}


def stem(word: str) -> str:
    """Very light stemmer: strips common suffixes."""
    for suffix in ("ing", "ed", "es", "s"):
        if word.endswith(suffix) and len(word) - len(suffix) >= 3:
            return word[: -len(suffix)]
    return word


def tokenize(text: str) -> list[str]:
    words = re.findall(r"[a-z0-9]+", text.lower())
    return [stem(w) for w in words if w not in STOP_WORDS]


VOCABULARY = {tok for intent in INTENTS for p in intent["patterns"] for tok in tokenize(p)}


def correct_typos(tokens: list[str]) -> list[str]:
    """Replace unknown words with the closest known word (if similar enough)."""
    fixed = []
    for tok in tokens:
        if tok in VOCABULARY or tok.isdigit():
            fixed.append(tok)
        else:
            match = difflib.get_close_matches(tok, VOCABULARY, n=1, cutoff=0.8)
            fixed.append(match[0] if match else tok)
    return fixed


# ---------------------------------------------------------------------------
# Intent matching
# ---------------------------------------------------------------------------
def dice_score(a: list[str], b: list[str]) -> float:
    sa, sb = set(a), set(b)
    if not sa or not sb:
        return 0.0
    return 2 * len(sa & sb) / (len(sa) + len(sb))


def classify(message: str, threshold: float = 0.5):
    tokens = correct_typos(tokenize(message))
    best_tag, best_score = None, 0.0
    for intent in INTENTS:
        for pattern in intent["patterns"]:
            score = dice_score(tokens, tokenize(pattern))
            if score > best_score:
                best_tag, best_score = intent["tag"], score
    return (best_tag, best_score) if best_score >= threshold else (None, best_score)


# ---------------------------------------------------------------------------
# Safe math evaluation (no eval())
# ---------------------------------------------------------------------------
OPERATORS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.Pow: operator.pow,
    ast.Mod: operator.mod,
    ast.USub: operator.neg,
}


def safe_eval(node):
    if isinstance(node, ast.Expression):
        return safe_eval(node.body)
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in OPERATORS:
        return OPERATORS[type(node.op)](safe_eval(node.left), safe_eval(node.right))
    if isinstance(node, ast.UnaryOp) and type(node.op) in OPERATORS:
        return OPERATORS[type(node.op)](safe_eval(node.operand))
    raise ValueError("unsupported expression")


def try_math(message: str):
    match = re.search(r"(?:calculate|solve|what is|what's|compute)?\s*([\d\s+\-*/().%^]+)$", message.lower())
    if not match:
        return None
    expression = match.group(1).strip().replace("^", "**")
    if not any(ch.isdigit() for ch in expression) or not re.search(r"[+\-*/%]", expression):
        return None
    try:
        result = safe_eval(ast.parse(expression, mode="eval"))
        return f"The answer is {round(result, 4):g}"
    except (ValueError, SyntaxError, ZeroDivisionError, OverflowError):
        return "Sorry, I couldn't calculate that."


